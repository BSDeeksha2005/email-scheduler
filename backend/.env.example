# Server
PORT=4000

# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=scheduler
PGPASSWORD=scheduler
PGDATABASE=scheduler

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ethereal (fake SMTP) - leave blank to auto-create a test account at startup
ETHEREAL_USER=
ETHEREAL_PASS=

# Rate limiting / concurrency (documented in README)
MAX_EMAILS_PER_HOUR=200
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
